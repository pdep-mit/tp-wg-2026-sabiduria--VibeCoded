import mejoras.*
// Archivo de tests de referencia, borrar luego de desarrollar propios
import personajes.*
import negocioMejoras.*
import basura.*

describe "grupo de tests" {

  test "Player comeinza en el centro del tabler" {
    assert.equals(game.center(), jugador.position())
  }

  test "Player agarra una basura al colisionarla" {
    const invInicial = jugador.items_recolectados().size()
    jugador.recolectarItem(botella)
    assert.equals(invInicial+1, jugador.items_recolectados().size())
  }

  test "Player se queda sin espacio cuando llega al máximo de su inventario" {
    const capacidadIncial = jugador.capacidadInventario()
    capacidadIncial.times({i=> jugador.recolectarItem(botella)})
    assert.that(jugador.sinInventario())
  }

  test "Player vende items recolectador"{
    // jugador.recolectarItem(botella)
    4.times({i=>jugador.recolectarItem(botella)})
    negocioMejoras.venderBasura(jugador)
    assert.equals(jugador.items_recolectados().size(), 0 )
  }

  test "Player vende items recolectador y gana dinero"{
    // jugador.recolectarItem(botella)
    4.times({i=>jugador.recolectarItem(botella)})
    negocioMejoras.venderBasura(jugador)
    assert.equals(jugador.dinero(), 16 )
  }

  test "Player vende items con la mejora de mayorValor"{
    4.times({i => jugador.recolectarItem(botella)})
    jugador.dinero(1000) // para que pueda comprar la mejora
    negocioMejoras.comprarMejora(jugador, mayorValor)
    negocioMejoras.venderBasura(jugador)
    assert.equals(20, jugador.dinero())
  }

}
