import wollok.game.*
import personajes.*
import basura.*

program HowToTrash {
	// TODO: Cambiar esto por lo que necesiten
	game.title("Grupo: Vibecoded | How To Trash")
	game.height(30)
	game.width(30)
	game.cellSize(20)

	//Agregar Visuales
	game.addVisual(jugador)
	botella.spawn()
	caja.spawn()
	papel.spawn()

	//Mecánicas
	game.whenCollideDo(jugador, {item => jugador.recolectarItem(item)})
	jugador.movimiento()
	game.start()
}
