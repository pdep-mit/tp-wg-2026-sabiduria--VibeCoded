import wollok.game.*
import personajes.*
import basura.*
import generador.*
import vendedor.*

program HowToTrash {
	// TODO: Cambiar esto por lo que necesiten
	game.title("Grupo: Vibecoded | How To Trash")
	game.height(15)
	game.width(15)
	game.cellSize(35)

	//Agregar Visuales
	game.addVisual(jugador)
	planificador.aparecer(botella)
	planificador.aparecer(caja)
	planificador.aparecer(papel)

	//Mecánicas
	//game.whenCollideDo(jugador, {item => jugador.recolectarItem(item)})
	jugador.movimiento()
	vendedor.abrirNegocio()
	game.whenCollideDo(jugador, {item => item.alColisionarCon(jugador)})

	game.start()
}
