import wollok.game.*
import personajes.*
import basura.*
import generador.*
import vendedor.*
import hud.*
import jefe.*
import gestorFondo.*
import configs.*

program HowToTrash {
	const tiempoDeAparicionDeBoss = config.tiempoDeAparicionDeBoss()
	contadorJefe.timer(tiempoDeAparicionDeBoss/1000)
	game.title("Grupo: Vibecoded | How To Trash")
	game.height(15)
	game.width(15)
	game.cellSize(35)

	// Agregar Visuales
	gestorFondo.desplegarFondo()
	game.addVisual(jugador)
	game.schedule(tiempoDeAparicionDeBoss, {
		planificador.pausarBasura()
		vendedor.cambiarMejoras()
	})

	planificador.despausarBasura()
	game.addVisual(cartelInv)
	game.addVisual(cartelCash)
	game.addVisual(salud)
	game.addVisual(contadorJefe)
	contadorJefe.comenzarContador()

	// Mecánicas y Controles
	jugador.controles()
	jugador.interaccion()
	vendedor.abrirNegocio()
	game.whenCollideDo(jugador, {item => item.alColisionarCon(jugador)})
	
	// Tecla para reiniciar (solo surtirá efecto si el juego ya terminó)
	keyboard.r().onPressDo({ config.reiniciar() })

	game.onTick(100, "actualizarHUD", {
		cartelInv.actualizar(jugador)
		cartelCash.actualizar(jugador)
		salud.actualizar(jugador)
	})
	
	game.start()
}
