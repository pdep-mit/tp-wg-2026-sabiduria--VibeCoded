import wollok.game.*
import personajes.*
import basura.*
import generador.*
import vendedor.*
import hud.*
import jefe.*

program HowToTrash {
	// const tick = game.tick(1000, {contadorJefe.actualizar(jugador)}, true) // para el contador de tiempo restante antes que aparezca el jefe ( agregar luego )
	game.title("Grupo: Vibecoded | How To Trash")
	game.height(15)
	game.width(15)
	game.cellSize(35)

	//Agregar Visuales
	game.boardGround("fondo3.jpg")
	game.addVisual(jugador)
	// jefe.aparecer() //Borrar, es oara ver el sprite no mas
	//game.schedule(20000, {jefe.actualizarJefe()})
	game.schedule(22000, {
		planificador.pausarBasura()
		vendedor.cambiarMejoras()
	})

	// game.addVisual(tentaculo)
	// game.addVisual(tentaculo1)
	
	planificador.despausarBasura()
	game.addVisual(cartelInv)
	//cartelInv.actualizar(jugador) // agregar cuando se haya definido su posicion
	game.addVisual(cartelCash)
	//cartelCash.actualizar(jugador) // agregar cuando se haya definido su posicion
	game.addVisual(salud)
	//game.addVisual(vidas)
	game.addVisual(contadorJefe) // agregar cuando se haya definido su posicion
	/*
	cartelInv.actualizar(jugador)
	cartelCash.actualizar(jugador)
	salud.actualizar(jugador)
	*/

	//Mecánicas
	//game.whenCollideDo(jugador, {item => jugador.recolectarItem(item)})
	jugador.controles()
	jugador.interaccion()
	vendedor.abrirNegocio()
	// tick.start() // actualiza el contador hasta que aparece el jefe ( agregar luego )
	game.whenCollideDo(jugador, {item => item.alColisionarCon(jugador)})
									//cartelInv.actualizar(jugador) // para el contador de inventario
									//cartelCash.actualizar(jugador) // para el contador de dinero
								//})
								//salud.actualizar(jugador)
	

	game.onTick(100, "actualizarHUD", {
    cartelInv.actualizar(jugador)
    cartelCash.actualizar(jugador)
    salud.actualizar(jugador)
	})
	game.start()
}
